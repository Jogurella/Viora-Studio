<Window x:Class="SwarmStudio.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Viora Studio" Width="1440" Height="960" MinWidth="1120" MinHeight="760" WindowStartupLocation="CenterScreen" Background="#080910" Foreground="#F3F4F7" FontFamily="Segoe UI" FontSize="14">
 <Window.Resources>
  <SolidColorBrush x:Key="Muted" Color="#A9A9BD"/>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style TargetType="Button"><Setter Property="Foreground" Value="#EDECF6"/><Setter Property="Background" Value="#252538"/><Setter Property="BorderBrush" Value="#44445D"/><Setter Property="Padding" Value="16,10"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" CornerRadius="12" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#11121E"/><Setter Property="Foreground" Value="#F3F4F7"/><Setter Property="CaretBrush" Value="White"/><Setter Property="BorderBrush" Value="#41415A"/><Setter Property="Padding" Value="12"/><Setter Property="FontSize" Value="15"/><Setter Property="SelectionBrush" Value="#7161D9"/></Style>
  <Style TargetType="ComboBox">
   <Setter Property="Foreground" Value="#EDECF6"/><Setter Property="Background" Value="#202130"/><Setter Property="MinHeight" Value="42"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#F3F4F7"/><Setter Property="Padding" Value="10"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Item" Padding="{TemplateBinding Padding}" Background="#202130"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="#493A71"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="Background" Value="#3B315A"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></Setter.Value></Setter>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
    <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen,Mode=TwoWay,RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border CornerRadius="10" Background="#202130" BorderBrush="#45405A" BorderThickness="1"><TextBlock Text="⌄" Foreground="#BBACDD" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/></Border></ControlTemplate></ToggleButton.Template></ToggleButton>
    <ContentPresenter Margin="12,8,30,8" VerticalAlignment="Center" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
    <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False"><Border Background="#202130" BorderBrush="#655780" BorderThickness="1" CornerRadius="8" MinWidth="{Binding ActualWidth,RelativeSource={RelativeSource TemplatedParent}}" Padding="4"><ScrollViewer MaxHeight="320"><StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border></Popup>
   </Grid></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="RadioButton"><Setter Property="Margin" Value="0,0,7,0"/><Setter Property="Foreground" Value="#BABACE"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="R" Background="#171825" BorderBrush="#3D3B55" BorderThickness="1" CornerRadius="12" Padding="13,11"><ContentPresenter HorizontalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="R" Property="Background" Value="#3E3266"/><Setter TargetName="R" Property="BorderBrush" Value="#A391FF"/><Setter Property="Foreground" Value="White"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="Panel" TargetType="Border"><Setter Property="CornerRadius" Value="22"/><Setter Property="BorderBrush" Value="#39354E"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="22"/><Setter Property="Background"><Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#242031"/><GradientStop Color="#141723" Offset="1"/></LinearGradientBrush></Setter.Value></Setter></Style>
  <Style x:Key="Label" TargetType="TextBlock"><Setter Property="Foreground" Value="#B6B3CB"/><Setter Property="FontSize" Value="12"/><Setter Property="Margin" Value="0,0,0,8"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <DataTemplate x:Key="QueueTemplate"><Border Background="#181925" CornerRadius="12" Padding="13" Margin="0,0,0,9"><StackPanel><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" MaxHeight="42" FontWeight="SemiBold"/><TextBlock Text="{Binding Detail}" Foreground="#9F9EB5" FontSize="11" Margin="0,7,0,5"/><TextBlock Text="{Binding Status}" Foreground="#B2A3FF" FontSize="12"/></StackPanel></Border></DataTemplate>
  <DataTemplate x:Key="GalleryTemplate"><Border Width="235" Margin="0,0,16,16" Background="#1B1C2B" CornerRadius="16" Padding="10"><StackPanel><Grid Height="160" Background="#12131F"><TextBlock Text="{Binding Icon}" FontSize="45" Foreground="#9E8DE4" VerticalAlignment="Center" HorizontalAlignment="Center"/><Image Stretch="UniformToFill" Source="{Binding FilePath}"><Image.Style><Style TargetType="Image"><Style.Triggers><DataTrigger Binding="{Binding Mode}" Value="video"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Image.Style></Image></Grid><TextBlock Text="{Binding Label}" Foreground="#BDADFF" FontSize="11" Margin="3,10,0,5"/><TextBlock Text="{Binding Title}" MaxHeight="40" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Time}" Foreground="#9899AC" FontSize="11" Margin="0,8,0,0"/></StackPanel></Border></DataTemplate>
 </Window.Resources>
 <Grid>
  <Ellipse Fill="#231A46" Width="800" Height="600" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-230,-280,0,0" IsHitTestVisible="False"><Ellipse.Effect><BlurEffect Radius="100"/></Ellipse.Effect></Ellipse>
  <Ellipse Fill="#102C38" Width="700" Height="600" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-300,-300" IsHitTestVisible="False"><Ellipse.Effect><BlurEffect Radius="100"/></Ellipse.Effect></Ellipse>
  <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="100"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Border Style="{StaticResource Panel}" Padding="20,12" Margin="0,0,0,18"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="◈" Foreground="#AF97FF" FontSize="32" Margin="0,0,12,0"/><StackPanel><TextBlock Text="VIORA STUDIO" FontSize="20" FontWeight="Bold"/><TextBlock Text="Deine Ideen. In Bewegung." Foreground="{StaticResource Muted}" FontSize="11"/></StackPanel></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"><Button Content="Studio" Click="StudioClick"/><Button Content="Galerie" Click="GalleryClick"/><Button Content="Warteschlange" Click="QueueClick"/></StackPanel><StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock x:Name="ConnectionLabel" Text="● Nicht verbunden" Foreground="#BBB5D0" VerticalAlignment="Center" Margin="12,0"/><Button Content="⚙ Einstellungen" Click="SettingsClick"/></StackPanel></Grid></Border>
   <Grid Grid.Row="1" x:Name="StudioPanel"><Grid.ColumnDefinitions><ColumnDefinition Width="340"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="260"/></Grid.ColumnDefinitions>
    <Border Style="{StaticResource Panel}" Padding="20"><DockPanel LastChildFill="True"><Button DockPanel.Dock="Bottom" x:Name="GenerateButton" Content="✦  Bild generieren" Height="56" FontWeight="Bold" FontSize="16" Margin="0,18,0,0" Click="GenerateClick"><Button.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#8B7BFF"/><GradientStop Offset="0.5" Color="#6D4CFF"/><GradientStop Offset="1" Color="#C14C91"/></LinearGradientBrush></Button.Background></Button><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
     <Grid Margin="0,0,0,22"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><RadioButton x:Name="ImageMode" GroupName="mode" Content="▧  Bild" IsChecked="True" Checked="ModeChanged"/><RadioButton Grid.Column="1" x:Name="VideoMode" GroupName="mode" Content="▶  Video" Checked="ModeChanged"/></Grid>
     <TextBlock Text="MODELL" Style="{StaticResource Label}"/><ComboBox x:Name="ModelPicker" Margin="0,0,0,20"/>
     <TextBlock Text="STIL" Style="{StaticResource Label}"/><UniformGrid Columns="3" Margin="0,0,0,20"><RadioButton x:Name="RealStyle" Content="Real" GroupName="style" IsChecked="True" ToolTip="Realistische Fotografie"/><RadioButton x:Name="AnimeStyle" Content="Anime" GroupName="style" ToolTip="Anime-Linien und Cel-Shading"/><RadioButton x:Name="AnimationStyle" Content="Animation" GroupName="style" FontSize="11"/></UniformGrid>
     <TextBlock Text="DEINE BESCHREIBUNG" Style="{StaticResource Label}"/><TextBox x:Name="PromptBox" Height="120" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Beschreibung"/>
     <TextBlock Text="Beschreibe Motiv und Bewegung. Englisch funktioniert meist am besten." Foreground="#9593AD" FontSize="11" Margin="0,8,0,18"/>
     <StackPanel x:Name="InputPanel" Visibility="Collapsed"><TextBlock Text="STARTBILD · OPTIONAL" Style="{StaticResource Label}"/><Button Content="＋ Bild auswählen" Click="PickInputClick" Margin="0,0,0,7"/><TextBlock x:Name="InputLabel" Text="Ohne Upload wird zuerst ein Startbild erzeugt." Foreground="#A6A1B8" FontSize="11"/><Button x:Name="ClearInput" Content="Startbild entfernen" Click="ClearInputClick" Margin="0,7,0,0" Visibility="Collapsed"/></StackPanel>
     <TextBlock Text="FORMAT" Style="{StaticResource Label}" Margin="0,20,0,8"/><ComboBox x:Name="AspectPicker" SelectedIndex="0"><ComboBoxItem Content="1:1 · Quadrat" Tag="square"/><ComboBoxItem Content="9:16 · Hochformat" Tag="portrait"/><ComboBoxItem Content="16:9 · Querformat" Tag="landscape"/></ComboBox>
     <Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="QUALITÄT" Style="{StaticResource Label}"/><ComboBox x:Name="QualityPicker" SelectedIndex="1" Margin="0,0,8,0"><ComboBoxItem Content="Entwurf"/><ComboBoxItem Content="Standard"/><ComboBoxItem Content="Detail"/></ComboBox></StackPanel><StackPanel Grid.Column="1"><TextBlock x:Name="QuantityTitle" Text="ANZAHL" Style="{StaticResource Label}"/><ComboBox x:Name="QuantityPicker" SelectedIndex="0"><ComboBoxItem Content="1 Bild" Tag="1"/><ComboBoxItem Content="2 Bilder" Tag="2"/><ComboBoxItem Content="4 Bilder" Tag="4"/></ComboBox><ComboBox x:Name="DurationPicker" SelectedIndex="1" Visibility="Collapsed"><ComboBoxItem Content="1,6 Sekunden" Tag="25"/><ComboBoxItem Content="3 Sekunden" Tag="49"/><ComboBoxItem Content="5 Sekunden" Tag="81"/></ComboBox></StackPanel></Grid>
     <Expander Header="Erweiterte Optionen" Foreground="#BEB5D9" Margin="0,20,0,0"><StackPanel Margin="0,12,0,0"><TextBlock Text="Negativ-Prompt" Style="{StaticResource Label}"/><TextBox x:Name="NegativeBox" Height="65" AcceptsReturn="True" TextWrapping="Wrap" Text="blurry, low quality, watermark, distorted anatomy"/><TextBlock Text="Seed (-1 = zufällig)" Style="{StaticResource Label}" Margin="0,12,0,8"/><TextBox x:Name="SeedBox" Text="-1"/></StackPanel></Expander>
    </StackPanel></ScrollViewer></DockPanel></Border>
    <Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Border Style="{StaticResource Panel}" Padding="18"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid><TextBlock Text="Dein Ergebnis" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="ResultTag" Text="BEREIT FÜR DEINE IDEE" Foreground="#A79BBF" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
     <Grid Grid.Row="1" Margin="0,18"><Border Background="#11131E" CornerRadius="16"/><StackPanel x:Name="EmptyPreview" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="◈" FontSize="78" Foreground="#8D73DA" HorizontalAlignment="Center"/><TextBlock Text="Aus einer Idee wird ein Bild." FontSize="22" TextAlignment="Center" Margin="0,15,0,10"/><TextBlock Text="Wähle einen Stil und beschreibe, was entstehen soll." Foreground="#A8A4BB" TextAlignment="Center" MaxWidth="300"/></StackPanel><Image x:Name="ResultImage" Stretch="Uniform" Visibility="Collapsed"/><MediaElement x:Name="ResultVideo" LoadedBehavior="Manual" UnloadedBehavior="Stop" Stretch="Uniform" Visibility="Collapsed" MediaEnded="VideoEnded" MediaFailed="VideoFailed"/></Grid>
     <StackPanel Grid.Row="2"><TextBlock x:Name="StageLabel" Text="Verbinde zuerst deinen KI-Server in den Einstellungen." Foreground="#BCB4D1" Margin="0,0,0,10"/><ProgressBar x:Name="RenderBar" Height="5" Maximum="100" Foreground="#9B80FF" Background="#262335" BorderThickness="0"/><WrapPanel Margin="0,15,0,0"><Button Content="▣ Datei öffnen" Click="OpenResultClick"/><Button Content="↗ Speichern unter" Click="SaveAsClick"/><Button Content="▶ Zu Video" Click="ToVideoClick"/><Button Content="☆ Favorit" Click="FavoriteClick"/></WrapPanel></StackPanel>
    </Grid></Border><Border Grid.Row="1" Style="{StaticResource Panel}" Padding="18" Margin="0,18,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Deine Galerie bleibt bei dir." FontWeight="SemiBold"/><TextBlock x:Name="FolderLabel" Text="Galerieordner in Einstellungen wählen" Foreground="#A49DB6" FontSize="11" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/></StackPanel><Button Grid.Column="1" Content="Ordner öffnen" Click="OpenFolderClick"/></Grid></Border></Grid>
    <Border Grid.Column="4" Style="{StaticResource Panel}" Padding="17"><DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="Warteschlange" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Aufträge dieses Geräts" Foreground="#AAA1BE" FontSize="11" Margin="0,7,0,18"/></StackPanel><StackPanel DockPanel.Dock="Bottom"><Button Content="Ausgewählten entfernen" Click="RemoveQueuedClick" Margin="0,10,0,8" FontSize="12"/><Button Content="Laufenden abbrechen" Click="CancelClick" Margin="0,0,0,10" FontSize="12"/><Button Content="Wartende starten" Click="ResumeQueueClick" Margin="0,0,0,10" FontSize="12"/><TextBlock Text="Videos brauchen auf einer RTX 3060 mehrere Minuten. Die Modellvorbereitung kann zunächst bei 0 % stehen." FontSize="11" Foreground="#8F89A5"/></StackPanel><ListBox x:Name="QueueList" Background="Transparent" BorderThickness="0" Foreground="White" ItemTemplate="{StaticResource QueueTemplate}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/></DockPanel></Border>
   </Grid>
   <Border Grid.Row="1" x:Name="GalleryPanel" Style="{StaticResource Panel}" Visibility="Collapsed"><DockPanel><StackPanel DockPanel.Dock="Top" Margin="0,0,0,20"><TextBlock Text="Deine Galerie" FontSize="28" FontWeight="Bold"/><TextBlock Text="Lokal gespeichert auf diesem Gerät · Doppelklick öffnet die Vorschau" Foreground="#A7A0B9" Margin="0,8,0,16"/><StackPanel Orientation="Horizontal"><ComboBox x:Name="GalleryFilter" SelectedIndex="0" Width="180" SelectionChanged="FilterChanged"><ComboBoxItem Content="Alle Ergebnisse"/><ComboBoxItem Content="Bilder"/><ComboBoxItem Content="Videos"/><ComboBoxItem Content="Favoriten"/></ComboBox><Button Content="Ordner auswählen" Click="ChooseFolderClick" Margin="12,0,0,0"/><Button Content="Ordner öffnen" Click="OpenFolderClick" Margin="12,0,0,0"/></StackPanel></StackPanel><ListBox x:Name="GalleryList" Background="Transparent" BorderThickness="0" Foreground="White" MouseDoubleClick="GalleryDoubleClick" ItemTemplate="{StaticResource GalleryTemplate}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel></ListBox></DockPanel></Border>
   <Grid Grid.Row="1" x:Name="SettingsPanel" Background="#D9080910" Visibility="Collapsed"><Border Style="{StaticResource Panel}" Width="680" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="32"><StackPanel><TextBlock Text="Dein Studio einrichten" FontSize="26" FontWeight="Bold"/><TextBlock Text="Der Server rechnet. Ergebnisse werden auf diesem PC gespeichert." Foreground="#B0A6C2" Margin="0,10,0,24"/><TextBlock Text="PRIVATE TAILSCALE-SERVERADRESSE" Style="{StaticResource Label}"/><TextBox x:Name="ServerBox" ToolTip="Zum Beispiel https://dein-server.dein-tailnet.ts.net:8443"/><TextBlock Text="Tailscale muss auf diesem PC verbunden sein. HTTPS-Zertifikate werden normal geprüft." Foreground="#AAA0B8" FontSize="12" Margin="0,8,0,22"/><TextBlock Text="GALERIEORDNER AUF DIESEM GERÄT" Style="{StaticResource Label}"/><DockPanel><Button DockPanel.Dock="Right" Content="Auswählen / anlegen" Click="ChooseFolderClick" Margin="10,0,0,0"/><TextBox x:Name="FolderBox" IsReadOnly="True"/></DockPanel><TextBlock Text="Bilder, Videos und ihre Metadaten bleiben bei Updates erhalten." Foreground="#AAA0B8" FontSize="12" Margin="0,8,0,22"/><TextBlock Text="GITHUB-UPDATEKANAL" Style="{StaticResource Label}"/><TextBox x:Name="RepositoryBox"/><WrapPanel Margin="0,24,0,0"><Button Content="Speichern &amp; verbinden" Click="ConnectClick" Background="#594597"/><Button Content="Nach Updates suchen" Click="UpdateClick"/><Button Content="Schließen" Click="CloseSettingsClick"/></WrapPanel><TextBlock x:Name="SettingsStatus" Margin="0,18,0,0" Foreground="#D4C6EE"/><TextBlock x:Name="VersionLabel" Text="Viora Studio" Foreground="#867D99" FontSize="11" Margin="0,20,0,0"/></StackPanel></Border></Grid>
  </Grid>
 </Grid>
</Window>


